{
  // Cloudflare Workers config. Workers Builds runs `npm run build`, then serves
  // ./dist as static assets. "single-page-application" is what makes /cat-rescue
  // survive a hard refresh instead of 404ing.
  "name": "parlok-studio",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
